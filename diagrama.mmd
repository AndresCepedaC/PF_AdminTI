        WEB_SRV["Web Server TechMarket<br/>(Catálogo & Inventario)"]
        DB_SRV[("PostgreSQL DB<br/>(Puerto 5432)")]
    end

    %% Servidor Linux Tradicional
    subgraph LINUX_BASE ["Servicios Linux Tradicionales (Host Ubuntu Server)"]
        NTP_SRV["Servidor NTP / Chrony<br/>(Puerto 123 UDP)"]
