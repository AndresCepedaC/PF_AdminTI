graph LR
    %% Clientes y Red Local
    subgraph CLIENTES ["Clientes y Estaciones de Trabajo"]
        WIN_MAC["Estaciones Windows / Mac<br/>(Ventas, Compras, Gerencia)"]
        LIN_CLI["Clientes Linux / Servidores<br/>(Terminales Técnicas y Bodega)"]
        ADMIN_CLI["Estación Administrador TI"]
    end

    %% Perímetro y Enrutamiento Web
    subgraph WEB_INFR ["Capa Web y PaaS (Dokploy / Docker)"]
        TRAEFIK["Dokploy / Traefik<br/>Reverse Proxy (80/443)"]
